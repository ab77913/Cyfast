# Service
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8099

# MongoDB (same DB as general_management — collection project_document_chunks)
MONGODB_URI=mongodb://mongoadmin:1secure%2Apassword1@127.0.0.1:27017/cyfast_general?authSource=admin

# MySQL — list INDEXED project documents (status filter)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=cyfast3

# --- LLM: OpenAI-compatible API or local/org Ollama ---
LLM_PROVIDER=openai

# When LLM_PROVIDER=openai — credentials from Azure Key Vault in deployed environments:
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# Vault secrets: openai-key → OPENAI_API_KEY, openai-endpoint → OPENAI_BASE_URL
# (override secret names with AZURE_KEY_VAULT_OPENAI_KEY_SECRET / AZURE_KEY_VAULT_OPENAI_ENDPOINT_SECRET)
# Local dev: set OPENAI_* below instead (process env overrides Key Vault).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# When LLM_PROVIDER=ollama (e.g. mistral:latest — pull with: ollama pull mistral)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:latest

# Seconds for one LLM HTTP call (requirements generate/regenerate hold the connection until completion).
# Slow local models or large prompts may need 900–1800. general_management AI_ENGINE_LLMS_TIMEOUT_MS
# (ms) must be >= this value (defaults: 480s vs 600000 ms).
# LLM_HTTP_TIMEOUT_SECONDS=720

# --- Per-capability LLM stacks (prefixes match capability keys in app.shared.llm_profiles) ---
# For each capability, omit or leave *_LLM_PROVIDER empty to inherit LLM_PROVIDER.
# Omit *_OPENAI_MODEL / *_OLLAMA_MODEL to inherit OPENAI_MODEL / OLLAMA_MODEL for that provider.

# Requirement generation (/v1/requirements*)
# REQUIREMENTS_LLM_PROVIDER=openai
# REQUIREMENTS_OPENAI_MODEL=gpt-4.1
# REQUIREMENTS_OLLAMA_MODEL=gpt-oss:latest

# Test scenarios from requirements (/v1/test_scenarios*)
# TEST_SCENARIOS_LLM_PROVIDER=ollama
# TEST_SCENARIOS_OPENAI_MODEL=gpt-4o-mini
# TEST_SCENARIOS_OLLAMA_MODEL=llama3.2:latest
# Optional: separate Ollama host for this route only (defaults to OLLAMA_BASE_URL)
# TEST_SCENARIOS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Generation validation rubrics (/v1/generation_validation*)
# Example: keep global OpenAI for generation, run validation on Ollama with a small local model.
# VALIDATION_LLM_PROVIDER=ollama
# VALIDATION_OPENAI_MODEL=gpt-4o-mini
# VALIDATION_OLLAMA_MODEL=llama3.1:8b

# Other capabilities use the same pattern (optional):
# TEST_CASES_*, TEST_DATA_*, TRACEABILITY_*, RAG_CHAT_*, RAG_TREE_*, TEST_SCRIPTS_*

# Hybrid RAG weights (vectorless: A=text+metadata, C=tree+LLM)
RAG_TEXT_WEIGHT=1.0
RAG_TREE_WEIGHT=0.85

# Optional: protect /v1/requirements|traceability|test_cases|test_data|test_script/* with X-Internal-Key header
# INTERNAL_API_KEY=

# Per-IP rolling window for those routes (requests per minute; 0 = off)
RATE_LIMIT_PER_MINUTE=60

# test_scripts (/v1/test_script/*)
# TEST_SCRIPTS_SESSION_BACKEND=memory
# TEST_SCRIPTS_SESSION_TTL_HOURS=24
# TEST_SCRIPTS_SESSION_FILE_DIR=data/test_scripts_sessions
# TEST_SCRIPTS_SESSION_MAX_MESSAGES_BEFORE_SUMMARIZE=8
# TEST_SCRIPTS_SESSION_RECENT_TURNS_TO_KEEP=2

# Optional RabbitMQ worker (python -m worker.document_events_consumer)
# Omit frame_max or use ≥4096 — Node URLs often use frameMax=0 (broker default); Pika rejects 0.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_AI_QUEUE=ai_rag_document_indexed
